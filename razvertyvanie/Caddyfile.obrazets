# Обратный прокси перед сервисом «Счета в банк».
#
# Этот файл — образец. Рабочий Caddyfile делает ustanovka.ps1: подставляет
# ваш домен вместо scheta.vashdomen.ru и кладёт рядом. Правьте рабочий,
# потом:  Restart-Service caddy
#
# Зачем он вообще нужен. Сам сервис слушает только 127.0.0.1 и наружу не
# смотрит. Наружу смотрит Caddy: он получает сертификат Let's Encrypt сам,
# без ручной возни, и продлевает его тоже сам. Без HTTPS в сервис просто
# не войти — кука сессии выдаётся с флагом secure, по голому HTTP браузер
# её не вернёт.

scheta.vashdomen.ru {
	reverse_proxy 127.0.0.1:8000 {
		# Настоящий адрес посетителя — для счётчика неудачных входов.
		# Сервис верит этому заголовку только от 127.0.0.1, то есть от Caddy.
		header_up X-Forwarded-For {remote_host}
	}

	# Через сервис ходят счета и фотографии счетов: 25 МБ на файл,
	# 600 МБ на пачку (пределы заданы в servis/app/pachki.py).
	request_body {
		max_size 600MB
	}

	encode gzip

	header {
		# Страницу сервиса нельзя открыть в чужом фрейме
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# Полгода ходить сюда только по HTTPS
		Strict-Transport-Security "max-age=15552000"
		-Server
	}

	log {
		output file zhurnal-dostupa.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# Пока домен не подключён, можно проверить по адресу сервера с самоподписанным
# сертификатом. Браузер будет ругаться — на время проверки это нормально,
# для сотрудников так оставлять нельзя.
#
# :443 {
# 	tls internal
# 	reverse_proxy 127.0.0.1:8000
# }
